{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ryanio.github.io/agent-places/schemas/place-file.json",
	"title": "A place's own file",
	"description": "Served at <origin>/.well-known/agent-places.json.",
	"type": "object",
	"required": [
		"spec",
		"place"
	],
	"properties": {
		"spec": {
			"const": "agent-places/0.1"
		},
		"place": {
			"type": "object",
			"required": [
				"id",
				"name",
				"home",
				"page",
				"keys"
			],
			"properties": {
				"id": {
					"type": "string",
					"pattern": "^[a-z][a-z0-9-]{1,23}$"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"home": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				},
				"page": {
					"type": "string",
					"description": "The pattern a token's own page there matches: anchored, https, naming only the place's own host or hosts under it."
				},
				"keys": {
					"type": "array",
					"minItems": 1,
					"maxItems": 2,
					"items": {
						"type": "object",
						"required": [
							"address",
							"signature"
						],
						"properties": {
							"address": {
								"type": "string",
								"pattern": "^0x[0-9a-fA-F]{40}$"
							},
							"signature": {
								"type": "string",
								"pattern": "^0x[0-9a-fA-F]+$",
								"description": "EIP-191 over: Agent Places: <id> at <origin> holds this key."
							}
						}
					}
				},
				"what": {
					"type": "string",
					"maxLength": 200
				},
				"join": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				},
				"rules": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				},
				"callback": {
					"type": "string",
					"format": "uri",
					"pattern": "^https://"
				},
				"collections": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^eip155:\\d+/erc721:0x[0-9a-fA-F]{40}$"
					}
				}
			}
		}
	}
}
