{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ryanio.github.io/agent-places/schemas/batch.json",
	"title": "A place's batch",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"reports"
	],
	"properties": {
		"reports": {
			"type": "array",
			"minItems": 1,
			"maxItems": 100,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"token",
					"place",
					"event",
					"url",
					"at",
					"signer",
					"signature"
				],
				"properties": {
					"token": {
						"type": "integer",
						"minimum": 0
					},
					"place": {
						"type": "string",
						"pattern": "^[a-z][a-z0-9-]{1,23}$",
						"description": "The place's id, as the collection registered it."
					},
					"event": {
						"type": "string",
						"enum": [
							"joined",
							"linked",
							"active",
							"did",
							"left"
						]
					},
					"url": {
						"type": "string",
						"format": "uri",
						"pattern": "^https://",
						"description": "The token's own page there; for a did, the thing on the place's own site."
					},
					"at": {
						"type": "integer",
						"description": "When it was signed, unix seconds, within 10 minutes of the collection's clock."
					},
					"week": {
						"type": "integer",
						"minimum": 0,
						"description": "With active: what the token did there in the last 7 days."
					},
					"what": {
						"type": "string",
						"enum": [
							"minted",
							"made",
							"built",
							"sold",
							"bought",
							"won",
							"gifted",
							"posted"
						],
						"description": "With did."
					},
					"title": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9 '.#&!,()-]{0,39}$",
						"description": "With did, optional."
					},
					"price": {
						"type": "object",
						"additionalProperties": false,
						"required": [
							"amount",
							"symbol"
						],
						"properties": {
							"amount": {
								"type": "number",
								"exclusiveMinimum": 0
							},
							"symbol": {
								"type": "string",
								"pattern": "^[A-Z][A-Z0-9]{1,9}$"
							}
						},
						"description": "With did sold or bought, optional."
					},
					"ref": {
						"type": "string",
						"pattern": "^[A-Za-z0-9_-]{1,64}$",
						"description": "With did: the place's own id for it."
					},
					"asset": {
						"type": "string",
						"pattern": "^eip155:\\d+/erc721:0x[0-9a-fA-F]{40}$",
						"description": "Given, the line names the token by this CAIP-19 id."
					},
					"signer": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]{40}$"
					},
					"signature": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]+$"
					}
				},
				"allOf": [
					{
						"if": {
							"properties": {
								"event": {
									"const": "active"
								}
							}
						},
						"then": {
							"required": [
								"week"
							]
						}
					},
					{
						"if": {
							"properties": {
								"event": {
									"const": "did"
								}
							}
						},
						"then": {
							"required": [
								"what",
								"ref"
							]
						}
					}
				]
			}
		}
	}
}
