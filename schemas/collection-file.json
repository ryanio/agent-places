{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ryanio.github.io/agent-places/schemas/collection-file.json",
	"title": "A collection's file",
	"description": "Served at <origin>/.well-known/agent-places.json. Readers ignore fields they don't know.",
	"type": "object",
	"required": [
		"spec",
		"collection",
		"report",
		"read",
		"places"
	],
	"properties": {
		"spec": {
			"const": "agent-places/0.1"
		},
		"collection": {
			"type": "object",
			"required": [
				"name",
				"asset",
				"item",
				"word"
			],
			"properties": {
				"name": {
					"type": "string"
				},
				"asset": {
					"type": "string",
					"pattern": "^eip155:\\d+/erc721:0x[0-9a-fA-F]{40}$"
				},
				"supply": {
					"type": "integer"
				},
				"item": {
					"type": "string"
				},
				"word": {
					"type": "string"
				},
				"keys": {
					"type": "array",
					"items": {
						"type": "string",
						"pattern": "^0x[0-9a-fA-F]{40}$"
					}
				}
			}
		},
		"report": {
			"type": "object",
			"required": [
				"one",
				"line",
				"events",
				"signing",
				"window"
			],
			"properties": {
				"one": {
					"type": "string"
				},
				"batch": {
					"type": "string"
				},
				"batchMax": {
					"type": "integer"
				},
				"perMinute": {
					"type": "integer"
				},
				"events": {
					"type": "array",
					"items": {
						"type": "string"
					}
				},
				"signing": {
					"const": "eip191"
				},
				"window": {
					"type": "integer"
				},
				"line": {
					"type": "string"
				},
				"assetLine": {
					"type": "string"
				}
			}
		},
		"read": {
			"type": "object",
			"properties": {
				"all": {
					"type": "string"
				},
				"token": {
					"type": "string"
				},
				"moves": {
					"type": "string"
				},
				"log": {
					"type": "string"
				},
				"happenings": {
					"type": "string"
				},
				"health": {
					"type": "string"
				},
				"places": {
					"type": "string"
				}
			}
		},
		"register": {
			"type": "string",
			"description": "Where a place sends its origin to ask to be added."
		},
		"places": {
			"type": "array",
			"items": {
				"type": "object",
				"required": [
					"id",
					"name",
					"page",
					"keys"
				],
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"home": {
						"type": "string"
					},
					"page": {
						"type": "string"
					},
					"keys": {
						"type": "array",
						"items": {
							"type": "string",
							"pattern": "^0x[0-9a-fA-F]{40}$"
						}
					},
					"what": {
						"type": "string"
					},
					"join": {
						"type": "string"
					}
				}
			}
		}
	}
}
